# =============================================================================
# Metora 環境變數範例檔案
# =============================================================================
# 使用方式: 複製此檔案為 .env 並填入實際值
#   cp .env.example .env
#
# 所有參數必須同時在 backend/app/core/config.py 的 Settings 類別中定義
# 詳細說明請參考: backend/app/core/config.py
# =============================================================================

# ===========================================
# 環境設定 (development | production)
# ===========================================
ENVIRONMENT=development

# ===========================================
# 服務器設定
# ===========================================
SERVER_HOST=127.0.0.1
SERVER_PORT=8002
SERVER_RELOAD=true

# ===========================================
# 使用者註冊設定 (B2B 系統預設關閉公開註冊)
# ===========================================
ALLOW_PUBLIC_REGISTRATION=False

# ===========================================
# 資料庫設定
# ===========================================
DB_DRIVER=postgresql+psycopg
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=metora
DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=5
DB_COMMAND_TIMEOUT=30

# ===========================================
# JWT 認證設定
# ===========================================
# 可使用以下指令生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===========================================
# CORS 設定
# ===========================================
CORS_ALLOW_ORIGINS=http://localhost:5173

# ===========================================
# Cookie 安全設定
# ===========================================
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=true

# ===========================================
# API 速率限制設定（按級別配置）
# ===========================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT=500
RATE_LIMIT_SENSITIVE=10
RATE_LIMIT_STRICT=5

# ===========================================
# LLM 提供商選擇
# 可選值: ollama | vllm | openai | azure_openai | google_gemini
# ===========================================
LLM_PROVIDER=vllm

# ===========================================
# Ollama 配置 (當 LLM_PROVIDER=ollama 時需要)
# ===========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_MAX_TOKENS=2048
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=30.0
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TOP_P=0.6
OLLAMA_TOP_K=40

# ===========================================
# vLLM 配置 (當 LLM_PROVIDER=vllm 時需要)
# ===========================================
# VLLM_BASE_URL=http://localhost:8001
VLLM_MODEL=your-model-name
VLLM_MAX_TOKENS=4096
VLLM_TEMPERATURE=0.7
VLLM_TIMEOUT=60.0
VLLM_TOP_P=0.95
VLLM_TOP_K=20

# ===========================================
# OpenAI 配置 (當 LLM_PROVIDER=openai 時需要)
# ===========================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60.0
OPENAI_TOP_P=1.0
OPENAI_ORGANIZATION=

# ===========================================
# Azure OpenAI 配置 (當 LLM_PROVIDER=azure_openai 時需要)
# ===========================================
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.7
AZURE_OPENAI_TIMEOUT=60.0
AZURE_OPENAI_TOP_P=1.0

# ===========================================
# Google Gemini 配置 (當 LLM_PROVIDER=google_gemini 時需要)
# ===========================================
GOOGLE_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.1-flash-lite-preview
GOOGLE_GEMINI_MAX_TOKENS=4096
GOOGLE_GEMINI_TEMPERATURE=0.2
GOOGLE_GEMINI_TIMEOUT=60.0
GOOGLE_GEMINI_TOP_P=1.0
GOOGLE_GEMINI_TOP_K=40

# ===========================================
# 日誌設定
# ===========================================
LOG_LEVEL=DEBUG
SHOW_SQL=false

# ===========================================
# Redis 設定
# ===========================================
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_CHAT_CACHE_TTL_HOURS=2

# ===========================================
# 檔案上傳配置
# ===========================================
UPLOAD_FILES_ROOT=./uploaded_files/
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=json,pdf,txt,md

# 遞迴文字分塊設定
RECURSIVE_TEXT_CHUNK_SIZE=1000
RECURSIVE_TEXT_CHUNK_OVERLAP=200

# 聊天附件上傳配置
CHAT_FILE_UPLOAD_ENABLED=True
CHAT_MAX_FILES_PER_MESSAGE=5

# 圖片配置
CHAT_IMAGE_MAX_SIZE=10485760
CHAT_IMAGE_ALLOWED_FORMATS=jpg,jpeg,png,gif,webp,bmp
CHAT_IMAGE_COMPRESS_ENABLED=True
CHAT_IMAGE_MAX_WIDTH=1280
CHAT_IMAGE_MAX_HEIGHT=720
CHAT_IMAGE_QUALITY=75

# PDF 配置
CHAT_PDF_ENABLED=True
CHAT_PDF_MAX_SIZE=52428800
CHAT_PDF_MAX_PAGES=10
CHAT_PDF_RENDER_DPI=300

# 檔案儲存
CHAT_FILES_STORAGE_PATH=./uploaded_files/chat_files/

# ===========================================
# RAG 系統設定
# ===========================================
# 嵌入模型配置
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_DEVICE=cuda:0
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MODEL_POOL_SIZE=1

# 重排序配置
RERANKER_ENABLED=True
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=cuda:0
RERANKER_USE_FP16=True
RERANKER_BATCH_SIZE=32
RERANKER_MAX_LENGTH=512
RERANKER_MODEL_POOL_SIZE=1

# 分數正規化配置
RERANKER_SCORE_NORMALIZATION=true
RRF_SCORE_NORMALIZATION=true
RRF_SIGMOID_SCALE=1000.0
RRF_SIGMOID_SHIFT=0.012

# 檢索結果數量
RAG_RETRIEVER_TOP_K=3

# ===========================================
# 向量資料庫配置 (chroma | pgvector)
# ===========================================
VECTOR_STORE_PROVIDER=pgvector
VECTOR_DISTANCE_METRIC=cosine
VECTOR_SEARCH_SCORE_THRESHOLD=0.6
VECTOR_STORE_DIR=./vector_stores
PGVECTOR_TABLE_PREFIX=vector_
PGVECTOR_EMBEDDING_DIM=1024


# ===========================================
# Sandbox 配置（Agent 程式碼執行環境）
# ===========================================
# 是否啟用 Sandbox（需要 Docker 環境）
SANDBOX_ENABLED=True
# Sandbox Docker 映像名稱
SANDBOX_IMAGE=metora-sandbox:latest
# 程式碼執行超時（秒）
SANDBOX_TIMEOUT=60
# 記憶體限制
SANDBOX_MEMORY_LIMIT=512m
# CPU 限制（核數）
SANDBOX_CPU_LIMIT=1.0
# 是否允許網路存取
SANDBOX_NETWORK_ENABLED=False
# Docker network 名稱（啟用網路時使用）
SANDBOX_NETWORK_NAME=
# 最大輸出大小（bytes）
SANDBOX_MAX_OUTPUT_SIZE=1048576
# Agent 最大工具調用迭代次數
SANDBOX_MAX_ITERATIONS=8


# ===========================================
# Graph 配置
# ===========================================
GRAPH_MEMORY_TURNS=3
QUERY_REWRITE_CONTEXT_TURNS=2
GRAPH_EXECUTION_TIMEOUT=240.0

# ===========================================
# 前端設定
# ===========================================
VITE_API_BASE_URL=http://localhost:8002
VITE_APP_TITLE=Metora AI

# ===========================================
# 模型存放路徑設定
# ===========================================
HUGGINGFACE_CACHE_DIR=./models/huggingface/hub

# ===========================================
# Docker 主機路徑設定（僅 docker-compose volumes 使用）
# 這些路徑是「主機上」的實際路徑，會掛載到容器內
# Windows 範例: C:/uploaded_files
# Linux 範例: /opt/metora/uploaded_files
# ===========================================
HOST_UPLOAD_PATH=/opt/metora/uploaded_files
HOST_VECTOR_STORE_PATH=/opt/metora/vector_stores
HOST_HUGGINGFACE_PATH=/opt/metora/models/huggingface/hub
VLLM_MODELS_PATH=/opt/metora/models/huggingface/hub
